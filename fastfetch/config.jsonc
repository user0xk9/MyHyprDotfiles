{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": { "type": "small", "padding": { "top": 1, "right": 3 } },
  "display": { "separator": "  " },
  "modules": [
    "title",
    "separator",
    { "type": "os",       "key": "󰣇 OS",      "keyColor": "blue" },
    { "type": "kernel",   "key": " Kernel",  "keyColor": "blue" },
    { "type": "uptime",   "key": "󰅐 Uptime",  "keyColor": "blue" },
    { "type": "packages", "key": "󰏖 Pkgs",    "keyColor": "magenta" },
    { "type": "shell",    "key": " Shell",   "keyColor": "magenta" },
    { "type": "wm",       "key": " WM",      "keyColor": "magenta" },
    { "type": "terminal", "key": " Term",    "keyColor": "magenta" },
    { "type": "cpu",      "key": "󰻠 CPU",     "keyColor": "cyan" },
    { "type": "gpu",      "key": "󰢮 GPU",     "keyColor": "cyan" },
    { "type": "memory",   "key": "󰍛 RAM",     "keyColor": "cyan" },
    { "type": "disk",     "key": "󰋊 Disk",    "keyColor": "cyan" },
    "break",
    "colors"
  ]
}
