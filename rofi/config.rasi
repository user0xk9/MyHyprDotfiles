configuration {
    modi: "drun,run,window";
    show-icons: true;
    display-drun: "  Приложения";
    display-run: "  Команда";
    display-window: "  Окна";
    drun-display-format: "{name}";
    font: "JetBrainsMono Nerd Font 12";
}

@import "colors.rasi"

* {
    background-color: transparent;
    text-color: @text;
}

window {
    width: 560px;
    background-color: rgba(30, 30, 46, 92%);
    border: 2px;
    border-color: @accent;
    border-radius: 14px;
}

mainbox {
    padding: 14px;
    spacing: 10px;
    children: [ inputbar, listview ];
}

inputbar {
    padding: 10px 14px;
    spacing: 10px;
    background-color: @surface;
    border-radius: 10px;
    children: [ prompt, entry ];
}

prompt { text-color: @accent; }
entry { placeholder: "Поиск..."; placeholder-color: @muted; }

listview {
    lines: 8;
    columns: 1;
    spacing: 4px;
    scrollbar: false;
}

element {
    padding: 8px 12px;
    spacing: 10px;
    border-radius: 10px;
}

element selected.normal {
    background-color: @accent;
    text-color: @base;
}

element-icon { size: 26px; }
element-text { vertical-align: 0.5; }
